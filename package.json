{
  "name": "@octalgia/idbfs",
  "version": "1.0.0",
  "private": false,
  "description": "A browser filesystem backed by IndexedDB.",
  "keywords": [
    "indexeddb",
    "filesystem",
    "browser",
    "react"
  ],
  "author": "Matt Dawson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matsondawson/idbfs.git"
  },
  "homepage": "https://github.com/matsondawson/idbfs#readme",
  "bugs": {
    "url": "https://github.com/matsondawson/idbfs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/lib/index.d.ts"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:run": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:ui": "NODE_OPTIONS=--no-experimental-webstorage vitest --ui",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "ignore": "^7.0.6"
  }
}
