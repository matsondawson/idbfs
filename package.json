{
  "name": "@octalgia/idbfs",
  "version": "1.0.0",
  "private": false,
  "description": "A browser filesystem backed by IndexedDB.",
  "keywords": [
    "browser",
    "filesystem",
    "indexeddb",
    "react"
  ],
  "homepage": "https://github.com/matsondawson/idbfs#readme",
  "bugs": {
    "url": "https://github.com/matsondawson/idbfs/issues"
  },
  "license": "MIT",
  "author": "Matt Dawson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matsondawson/idbfs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:run": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:ui": "NODE_OPTIONS=--no-experimental-webstorage vitest --ui",
    "update": "pnpx npm-check-updates -i --format group"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "ignore": "^7.0.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^25.0.8",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "packageManager": "pnpm@11.17.0"
}
